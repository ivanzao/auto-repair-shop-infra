{
  "uid": "auto-repair-orders-ops",
  "title": "Auto Repair Shop: Orders Operations",
  "tags": [
    "auto-repair-shop",
    "business"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      },
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Ordens criadas (últimas 24h)",
      "id": 1,
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum(increase(orders_total[24h]))",
          "refId": "A",
          "legendFormat": "criadas"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "type": "stat",
      "title": "Aguardando diagnóstico agora",
      "description": "O diagnóstico mora no execution, não no order: a métrica é execution_by_status_total. Estimado por diferença de contadores de transição (entrou em AWAITING_DIAGNOSIS menos entrou em RESERVED), então superestima pelas execuções canceladas por falta de insumo. Depende da instrumentacao da MetricsPort no execution.",
      "id": 2,
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum(execution_by_status_total{status=\"AWAITING_DIAGNOSIS\"}) - sum(execution_by_status_total{status=\"RESERVED\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "type": "stat",
      "title": "Aguardando aprovação agora",
      "description": "Entrou em WAITING_APPROVAL menos entrou em EXECUTION_ENQUEUED. Superestima pelas OS canceladas a partir de WAITING_APPROVAL (recusa, falha de pagamento, reserva expirada).",
      "id": 10,
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum(orders_by_status_total{status=\"WAITING_APPROVAL\"}) - sum(orders_by_status_total{status=\"EXECUTION_ENQUEUED\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "type": "stat",
      "title": "Na fila de execução agora",
      "description": "OS pagas esperando o mecânico chamar POST /v1/orders/{id}/start. Entrou em EXECUTION_ENQUEUED menos entrou em IN_PROGRESS.",
      "id": 11,
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum(orders_by_status_total{status=\"EXECUTION_ENQUEUED\"}) - sum(orders_by_status_total{status=\"IN_PROGRESS\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "type": "stat",
      "title": "Em execução agora",
      "description": "Entrou em IN_PROGRESS menos entrou em COMPLETED. Superestima pelas OS canceladas durante a execução (ExecutionFailed).",
      "id": 3,
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum(orders_by_status_total{status=\"IN_PROGRESS\"}) - sum(orders_by_status_total{status=\"COMPLETED\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "type": "stat",
      "title": "Finalizadas (24h)",
      "id": 4,
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum(increase(orders_by_status_total{status=\"COMPLETED\"}[24h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Volume de criação de OS (rate por hora)",
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum(rate(orders_total[5m])) * 3600",
          "refId": "A",
          "legendFormat": "OS/hora"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineInterpolation": "smooth",
            "fillOpacity": 20
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Transições por status (rate)",
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(orders_by_status_total[5m]))",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineInterpolation": "smooth"
          }
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Distribuição cumulativa por status (todas as transições)",
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum by (status) (orders_by_status_total)",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Tempo médio em cada status (segundos)",
      "description": "Calculado a partir do log estruturado event=order.status_changed via LogQL unwrap em duration_in_previous_seconds.",
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "loki",
        "uid": "$loki"
      },
      "targets": [
        {
          "expr": "avg by (from_status) (avg_over_time({app=\"order\"} | json | event=\"order.status_changed\" | unwrap duration_in_previous_seconds [$__range]))",
          "refId": "A",
          "legendFormat": "{{from_status}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "p95 do tempo em cada status (segundos)",
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "datasource": {
        "type": "loki",
        "uid": "$loki"
      },
      "targets": [
        {
          "expr": "quantile_over_time(0.95, {app=\"order\"} | json | event=\"order.status_changed\" | unwrap duration_in_previous_seconds [5m]) by (from_status)",
          "refId": "A",
          "legendFormat": "{{from_status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineInterpolation": "smooth"
          }
        }
      }
    }
  ]
}
