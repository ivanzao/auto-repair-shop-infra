{
  "uid": "auto-repair-errors",
  "title": "Auto Repair Shop — Errors & Integrations",
  "tags": ["auto-repair-shop", "errors"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "5xx (req/s)",
      "id": 1,
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "sum(rate(ktor_http_server_requests_seconds_count{job=~\".*auto-repair-shop.*\",status=~\"5..\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "4xx (req/s)",
      "id": 2,
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "sum(rate(ktor_http_server_requests_seconds_count{job=~\".*auto-repair-shop.*\",status=~\"4..\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "stat",
      "title": "App pods restarting (1h)",
      "id": 3,
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=~\"auto-repair-shop-.*\"}[1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Erro logs (5m)",
      "id": 4,
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "loki", "uid": "$loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({app=\"auto-repair-shop\"} |= `\"level\":\"ERROR\"` [5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "timeseries",
      "title": "Status codes 4xx/5xx ao longo do tempo",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "sum by (status) (rate(ktor_http_server_requests_seconds_count{job=~\".*auto-repair-shop.*\",status=~\"[45]..\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "timeseries",
      "title": "Volume de logs por nível",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "loki", "uid": "$loki" },
      "targets": [
        {
          "expr": "sum by (level) (rate({app=\"auto-repair-shop\"} | json | __error__=\"\" [5m]))",
          "refId": "A",
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "table",
      "title": "Últimos erros (Loki)",
      "id": 7,
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 13 },
      "datasource": { "type": "loki", "uid": "$loki" },
      "targets": [
        {
          "expr": "{app=\"auto-repair-shop\"} |~ `\"level\":\"ERROR\"` | json | level=\"ERROR\" | label_format stack_short=`{{ printf \"%.500s\" .stack_trace }}`",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": { "source": "labels" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "labels": true,
              "labelTypes": true,
              "tsNs": true,
              "id": true,
              "@timestamp": true,
              "@version": true,
              "level": true,
              "level_value": true,
              "thread_name": true,
              "logger_name": true,
              "service": true,
              "service_name": true,
              "app": true,
              "container": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "pod": true,
              "stream": true,
              "detected_level": true,
              "stack_trace": true
            },
            "indexByName": {
              "Time": 0,
              "message": 1,
              "stack_short": 2
            },
            "renameByName": {
              "Time": "Data/Hora",
              "message": "Exception",
              "stack_short": "Stacktrace (500 chars)"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Data/Hora", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "left", "filterable": false }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Data/Hora" }, "properties": [{ "id": "custom.width", "value": 180 }] },
          { "matcher": { "id": "byName", "options": "Exception" }, "properties": [{ "id": "custom.width", "value": 500 }] }
        ]
      }
    }
  ]
}
